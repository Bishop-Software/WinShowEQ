# ============================================================
# WinShowEQ — Git Ignore Configuration
# Matches the Claude allow-list strategy
# ============================================================

# Logs
/logs/

# Internal Documentation
/design

# Local configuration file, may contain sensitive data
/server/config.ini
/client/client.ini

# --- Rust build artifacts ---
/target/
/debug/
/release/
/**/.fingerprint/
/**/incremental/
/**/deps/

# --- Installer output ---
/installer-output/
/installer-stage/

# --- Binaries & compiled artifacts ---
*.exe
*.dll
*.pdb
*.msi
*.so
*.dylib
*.a
*.lib

# --- Databases & caches ---
*.db
*.mdb
*.sqlite
*.sqlite3
*.cache
*.tmp
*.log

# --- OS / Editor junk ---
.DS_Store
Thumbs.db
*.swp
*.swo

# --- JetBrains / VSCode metadata ---
.idea/
.vscode/

# --- Node/Web artifacts (future-proofing) ---
node_modules/
dist/
build/

# --- Map data (large, generated) ---
maps/tiles/
maps/generated/
maps/cache/

# --- Branding exports (keep design sources only) ---
icons/exported/
branding/renders/
branding/previews/

# --- Cargo & Rust toolchain metadata ---
.cargo/
.rustup/
.rustc_info.json

# --- Local config files that should not be committed ---
settings.local.json
target_sqlite.db

# --- Ignore cocoindex runtime artifacts ---
.cocoindex_code/

# Claude files that are not source code or metadata
CLAUDE.md
.claude/
.claudeignore

# ============================================================
# Files and directories we explicitly KEEP (do NOT ignore)
# ============================================================

# Workspace crates
!client/
!client/src/**
!client/Cargo.toml

!server/
!server/src/**
!server/Cargo.toml

!common/
!common/src/**
!common/Cargo.toml

# Root manifests & docs
!Cargo.toml
!Cargo.lock
!README.md
!LICENSE

# Installer code (maintained)
!installer/**
!WinShowEQ.iss
!build-installer.ps1

# Design assets (source files)
!design/**

# Scripts (test harnesses, utilities)
!scripts/**

# GitHub workflows
!.github/**

# Server config files
!server/myseqserver.ini
!server/patterns.ini

