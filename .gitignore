# ============================
#   WinShowEQ – .gitignore
# ============================

# --- Rust build artifacts ---
/target/
/debug/
/release/

# --- Cargo & Rust tooling ---
.cargo/
/rust-toolchain.toml
.rustup/
.rustc_info.json

# --- Binaries & installers ---
*.exe
*.dll
*.pdb
*.so
*.dylib
*.a
*.lib
*.msi
/build/
/dist/
/installer/

# --- Logs & runtime output ---
*.log
*.out
*.tmp
*.bak
*.cache
*.pid

# --- Documentation ---
/doc/
/target/doc/

# --- Map assets ---
/maps/generated/
/maps/cache/
/maps/tiles/**

# Keep small static assets:
/maps/static/**

# --- Packet captures ---
*.pcap
*.pcapng
/test_data/captures/

# --- Branding / Icons ---
/icons/exported/
/branding/renders/
/branding/previews/

# Keep source SVGs:
/icons/src/**

# --- IDE / Editor ---
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db

# --- Node (if future UI) ---
node_modules/
dist/
build/



# These are backup files generated by rustfmt
**/*.rs.bk



# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/


# Claude
# .claude
# .claudeignore
# CLAUDE.md
/.cocoindex_code/


# Local configuration file, may contain sensitive data
/server/config.ini
